{
  "name": "onejump",
  "version": "0.1.0",
  "private": true,
  "description": "OneJump: coaching software for personal trainers and online coaches, with Assist, an AI copilot.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "postinstall": "node scripts/generate.js",
    "db:generate": "node scripts/generate.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node prisma/seed.js",
    "lint": "node scripts/lint.js",
    "test": "node scripts/lint.js && vitest run",
    "test:e2e": "playwright test",
    "jobs:nightly": "node server/jobs/run-once.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/prisma-schema-wasm": "^7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
