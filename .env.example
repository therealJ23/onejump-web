# OneJump environment variables. For local development: `cp .env.example .env` works as is
# with scripts/setup-local-db.sql (those passwords are for your own computer only).
# Never commit .env. Everything marked "server only" must never reach the browser.

NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Database (MySQL 8) ---------------------------------------------------
# App user: SELECT, INSERT, UPDATE, DELETE only (no DROP/GRANT).          server only
DATABASE_URL=mysql://onejump_app:app-dev-password@localhost:3306/onejump
# Migration user: used only by `npm run db:migrate`.                       server only
MIGRATE_DATABASE_URL=mysql://onejump_migrate:migrate-dev-password@localhost:3306/onejump
# Managed MySQL (DigitalOcean) needs TLS: paste the CA certificate (PEM) here, or set DATABASE_SSL=true.
DATABASE_CA_CERT=
DATABASE_SSL=false
# Tests use their own database (wiped on every run).
TEST_DATABASE_URL=mysql://onejump_app:app-dev-password@localhost:3306/onejump_test
TEST_MIGRATE_DATABASE_URL=mysql://onejump_migrate:migrate-dev-password@localhost:3306/onejump_test

# --- Sessions -------------------------------------------------------------
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=                   # server only; optional locally, required (32+ chars) in production

# --- AI (Assist) ----------------------------------------------------------
AI_PROVIDER=mock                  # mock | anthropic | openai
ANTHROPIC_API_KEY=                # server only
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=                   # server only
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET_USD=5           # per coach workspace

# --- Payments (Stripe) ----------------------------------------------------
PAYMENTS_PROVIDER=mock            # mock | stripe
STRIPE_SECRET_KEY=                # server only, sk_test_… while building
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=            # platform events (OneJump plans)
STRIPE_CONNECT_WEBHOOK_SECRET=    # connected-account events (client payments)
STRIPE_PRICE_STARTER=             # price_… for $29/mo
STRIPE_PRICE_PRO=                 # price_… for $59/mo
STRIPE_PRICE_STUDIO=              # price_… for $99/mo

# --- Email (Resend) -------------------------------------------------------
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=                   # server only
EMAIL_FROM=OneJump <hello@onejumpfit.com>

# --- Files (Cloudflare R2, private bucket) --------------------------------
STORAGE_PROVIDER=local            # local | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                 # server only
R2_SECRET_ACCESS_KEY=             # server only
R2_BUCKET=onejump-private

# --- Voice (Talk to Assist, voice notes, morning briefing) ----------------
VOICE_PROVIDER=mock               # mock | deepgram | openai (openai uses OPENAI_API_KEY)
VOICE_TTS=browser                 # browser (free, the device's own voice) | deepgram
DEEPGRAM_API_KEY=                 # server only
DEEPGRAM_MODEL=nova-3             # speech to text
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
OPENAI_TRANSCRIBE_MODEL=whisper-1
VOICE_MONTHLY_MINUTES=300         # per coach workspace; dictation in text boxes is free and unlimited

# --- Nutrition --------------------------------------------------------------
FOOD_DATA_PROVIDER=               # empty = live when FDC_API_KEY is set, otherwise mock | live | mock
FDC_API_KEY=                      # free from api.data.gov, server only (USDA FoodData Central)
OFF_USER_AGENT=OneJump/1.0 (hello@onejumpfit.com)   # Open Food Facts asks apps to identify themselves
NUTRITION_PHOTO_MODEL=claude-haiku-4-5-20251001
NUTRITION_PHOTOS_MONTHLY=3000     # meal photos per coach workspace per month
NUTRITION_PHOTOS_PER_CLIENT_DAILY=20

# --- Jobs -----------------------------------------------------------------
JOBS_ENABLED=true                 # node-cron inside the server (risk scoring, automations)

# OneJump HQ (/admin): accounts listed here get HQ access when they log in (comma-separated)
HQ_ADMIN_EMAILS=
HQ_TIMEZONE=America/New_York   # months and days on HQ
